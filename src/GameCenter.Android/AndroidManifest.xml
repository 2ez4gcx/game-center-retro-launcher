<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- extractNativeLibs: core libretro phải nằm thành file thật trên máy thì mới nạp được theo đường dẫn -->
	<!-- Tùy chọn "dùng thư mục GameCenter ở bộ nhớ trong": Android 11+ cần quyền truy cập mọi file (người dùng tự bật),
	     Android 10 trở xuống cần quyền bộ nhớ. Không bật thì app vẫn chạy với thư mục riêng trong Android/data. -->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
	<application android:label="Game Center" android:extractNativeLibs="true" android:allowBackup="true" android:isGame="true"
	             android:requestLegacyExternalStorage="true" />
</manifest>
